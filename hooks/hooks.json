{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "python3 ./bin/datastash-cursor hook", "timeout": 10 }
    ],
    "beforeMCPExecution": [
      { "command": "python3 ./bin/datastash-cursor hook", "timeout": 10, "failClosed": true }
    ],
    "afterMCPExecution": [
      { "command": "python3 ./bin/datastash-cursor hook", "timeout": 40 }
    ],
    "postToolUse": [
      { "command": "python3 ./bin/datastash-cursor hook", "timeout": 40 }
    ],
    "stop": [
      { "command": "python3 ./bin/datastash-cursor hook", "timeout": 15 }
    ]
  }
}
